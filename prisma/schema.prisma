generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String
  phone        String?
  avatar       String?              @db.LongText // allow large blobs (data URLs / binary-encoded)
  passwordAlgo String
  passwordIter Int
  passwordSalt String
  passwordHash String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  resetTokens   PasswordResetToken[]
  refreshTokens RefreshToken[]
  roles         UserRole[]

  // Common access patterns:
  // - Admin user list sorted by createdAt desc
  // - Lookups by email already covered by @unique
  @@index([createdAt])
}

model PasswordResetToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  ip        String?

  // Materialized fields extracted from meta for faster filtering/search (optional)
  targetUserId String?
  targetEmail  String?
  resource     String?
  statusCode   Int?

  // JSON string (full meta). Not always returned in list payload.
  meta       String?
  metaPreview String? // short preview string for list views

  createdAt DateTime @default(now())

  // Common access patterns:
  // - Admin audit log list sorted by createdAt desc
  // - Filter by action/userId
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([userId, createdAt])
  // Faster filtering for common incidents
  @@index([targetUserId, createdAt])
  @@index([targetEmail, createdAt])
  @@index([resource, createdAt])
  @@index([statusCode, createdAt])
  @@index([targetEmail, statusCode, createdAt])
  @@index([resource, statusCode, createdAt])
}

model Permission {
  id   String @id @default(cuid())
  name String @unique

  roles RolePermission[]

  // Fast ordered listing by name
  @@index([name])
}

model Role {
  id    String @id @default(cuid())
  name  String @unique

  users       UserRole[]
  permissions RolePermission[]

  // Fast ordered listing by name
  @@index([name])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission  Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// Small key-value store for one-time flags / app settings.
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum ExportJobStatus {
  pending
  running
  completed
  failed
  cancelled
}

model AuditLogExportJob {
  id        String          @id @default(cuid())
  status    ExportJobStatus @default(pending)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Who requested (optional)
  requestedByUserId String?

  // Filters snapshot (stored as JSON string for flexibility)
  filters String

  // Output
  fileName String?
  mimeType String?
  // File location relative to EXPORT_DIR
  filePath String?

  // Progress
  rowsWritten Int @default(0)

  // Queue/worker leasing
  leaseUntil DateTime?
  attempts   Int      @default(0)

  // Legacy storage (kept for backward compatibility / migrations)
  csvBase64 String?

  error String?

  @@index([status, createdAt])
  @@index([requestedByUserId, createdAt])
}

// ===== DASHBOARD DATA MODELS =====

enum OrderStatus {
  pending
  preparing
  delivered
  cancelled
}

model Order {
  id         String      @id @default(cuid())
  customerId String?
  customerName String
  item       String
  total      Int         // in smallest currency unit (e.g., Rupiah)
  status     OrderStatus @default(pending)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
}

model DailyRevenue {
  id        String   @id @default(cuid())
  date      DateTime @unique
  revenue   Int      // total revenue for the day
  orders    Int      // total orders for the day
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// ===== ANALYTICS MODELS =====

model Insight {
  id        String   @id @default(cuid())
  icon      String
  title     String
  description String
  value     String
  change    String?
  category  String   @default("general")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isActive])
  @@index([sortOrder])
}

model UsageTrend {
  id        String   @id @default(cuid())
  label     String
  value     String
  change    String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model DailyUsage {
  id        String   @id @default(cuid())
  day       String
  date      DateTime
  users     Int
  sessions  Int
  pageViews Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

model EngagementPulse {
  id        String   @id @default(cuid())
  time      String
  label     String
  change    String
  icon      String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model TopCTA {
  id        String   @id @default(cuid())
  label     String
  clicks    Int
  rate      String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([clicks])
}

model CustomerJourney {
  id         String   @id @default(cuid())
  persona    String
  icon       String
  steps      String   // JSON array stored as string
  completion Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
}

// ===== FEATURES MODELS =====

enum ExperimentStatus {
  planning
  testing
  running
  paused
  winner
  completed
}

model FeatureExperiment {
  id        String           @id @default(cuid())
  name      String
  icon      String?
  status    ExperimentStatus @default(planning)
  result    String?
  owner     String?
  progress  Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status])
}

model ComponentLib {
  id          String   @id @default(cuid())
  name        String
  description String
  status      String   @default("stable") // stable, beta, deprecated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model FeatureSpotlight {
  id          String   @id @default(cuid())
  icon        String
  name        String
  description String
  adoption    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model TeamTestimonial {
  id        String   @id @default(cuid())
  team      String
  quote     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeatureFlag {
  id        String   @id @default(cuid())
  name      String   @unique
  enabled   Boolean  @default(false)
  users     String   @default("0%")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

enum AlertStatus {
  active
  draft
  disabled
}

model AlertRule {
  id          String      @id @default(cuid())
  name        String
  condition   String?
  channel     String
  status      AlertStatus @default(draft)
  triggered   Int         @default(0)
  lastTriggeredAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
}

// ===== OPERATIONS MODELS =====

enum ServiceStatus {
  operational
  degraded
  outage
  maintenance
}

model Service {
  id        String        @id @default(cuid())
  name      String
  status    ServiceStatus @default(operational)
  uptime    String        @default("99.9%")
  lastCheckAt DateTime    @default(now())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}

enum QueueStatus {
  healthy
  stable
  watch
  critical
}

model QueueMetric {
  id        String      @id @default(cuid())
  name      String
  count     Int         @default(0)
  status    QueueStatus @default(healthy)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
}

enum IncidentSeverity {
  low
  medium
  high
  critical
}

enum IncidentStatus {
  investigating
  identified
  mitigated
  resolved
}

model Incident {
  id          String           @id @default(cuid())
  incidentId  String           @unique // Human readable ID like INC-001
  time        String
  detail      String
  severity    IncidentSeverity @default(low)
  status      IncidentStatus   @default(investigating)
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

enum ActionPriority {
  low
  medium
  high
  critical
}

model ActionItem {
  id          String         @id @default(cuid())
  title       String
  description String?
  owner       String?
  priority    ActionPriority @default(medium)
  completed   Boolean        @default(false)
  completedAt DateTime?
  dueDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([priority])
  @@index([completed])
  @@index([dueDate])
}

model PlaybookStep {
  id          String   @id @default(cuid())
  title       String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  completions PlaybookCompletion[]

  @@index([sortOrder])
  @@index([isActive])
}

model PlaybookCompletion {
  id        String       @id @default(cuid())
  stepId    String
  userId    String
  date      DateTime     @default(now())
  createdAt DateTime     @default(now())

  step      PlaybookStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, userId, date])
  @@index([userId, date])
}

// ===== FEEDBACK & GROWTH MODELS =====

enum FeedbackSentiment {
  positive
  mixed
  negative
}

model Feedback {
  id        String            @id @default(cuid())
  title     String
  detail    String
  sentiment FeedbackSentiment @default(mixed)
  source    String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([sentiment])
  @@index([createdAt])
}

model PricingExperiment {
  id        String   @id @default(cuid())
  title     String
  value     String
  change    String
  isActive  Boolean  @default(true)
  startDate DateTime @default(now())
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model ReleaseNote {
  id        String   @id @default(cuid())
  version   String
  date      DateTime
  items     String   // JSON array stored as string
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([category])
}

model Campaign {
  id          String    @id @default(cuid())
  date        String    // Day of week or specific date
  title       String
  note        String?
  scheduledAt DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@index([scheduledAt])
}

model TeamRitual {
  id          String   @id @default(cuid())
  title       String
  detail      String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

model CustomerSuccessMetric {
  id        String   @id @default(cuid())
  title     String
  value     String
  change    String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model RevenueMetric {
  id        String   @id @default(cuid())
  title     String
  value     String
  change    String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// ===== HEATMAP & INTERACTION MODELS =====

model HeatmapHotspot {
  id        String   @id @default(cuid())
  area      String
  clicks    Int      @default(0)
  rate      String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([clicks])
}

model DeviceStat {
  id         String   @id @default(cuid())
  deviceType String
  percentage Int
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
}

model HeatmapSummary {
  id           String   @id @default(cuid())
  totalClicks  Int      @default(0)
  avgSession   String
  scrollDepth  Int      @default(0)
  date         DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

// ===== SECURITY MODELS =====

enum SecurityEventSeverity {
  info
  warning
  danger
}

model SecurityEvent {
  id        String                @id @default(cuid())
  event     String
  severity  SecurityEventSeverity @default(info)
  userId    String?
  ip        String?
  userAgent String?
  createdAt DateTime              @default(now())

  @@index([severity])
  @@index([userId])
  @@index([createdAt])
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  device     String
  location   String?
  ip         String?
  userAgent  String?
  isActive   Boolean   @default(true)
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
  @@index([isActive])
  @@index([lastSeenAt])
}

// ===== SELLER MODELS =====

model SellerProduct {
  id          String   @id @default(cuid())
  name        String
  price       Int
  stock       Int
  category    String
  description String
  image       String   @db.LongText // large blob-like storage for full data URLs / long paths
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]

  @@index([updatedAt])
}

model Transaction {
  id          String   @id @default(cuid())
  productId   String?
  productName String
  price       Int
  createdAt   DateTime @default(now())

  product     SellerProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
