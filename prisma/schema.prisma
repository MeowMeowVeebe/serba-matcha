generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String
  passwordAlgo String
  passwordIter Int
  passwordSalt String
  passwordHash String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  resetTokens   PasswordResetToken[]
  refreshTokens RefreshToken[]
  roles         UserRole[]

  // Common access patterns:
  // - Admin user list sorted by createdAt desc
  // - Lookups by email already covered by @unique
  @@index([createdAt])
}

model PasswordResetToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  ip        String?

  // Materialized fields extracted from meta for faster filtering/search (optional)
  targetUserId String?
  targetEmail  String?
  resource     String?
  statusCode   Int?

  // JSON string (full meta). Not always returned in list payload.
  meta       String?
  metaPreview String? // short preview string for list views

  createdAt DateTime @default(now())

  // Common access patterns:
  // - Admin audit log list sorted by createdAt desc
  // - Filter by action/userId
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([userId, createdAt])
  // Faster filtering for common incidents
  @@index([targetUserId, createdAt])
  @@index([targetEmail, createdAt])
  @@index([resource, createdAt])
  @@index([statusCode, createdAt])
  @@index([targetEmail, statusCode, createdAt])
  @@index([resource, statusCode, createdAt])
}

model Permission {
  id   String @id @default(cuid())
  name String @unique

  roles RolePermission[]

  // Fast ordered listing by name
  @@index([name])
}

model Role {
  id    String @id @default(cuid())
  name  String @unique

  users       UserRole[]
  permissions RolePermission[]

  // Fast ordered listing by name
  @@index([name])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission  Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// Small key-value store for one-time flags / app settings.
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum ExportJobStatus {
  pending
  running
  completed
  failed
  cancelled
}

model AuditLogExportJob {
  id        String          @id @default(cuid())
  status    ExportJobStatus @default(pending)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Who requested (optional)
  requestedByUserId String?

  // Filters snapshot (stored as JSON string for flexibility)
  filters String

  // Output
  fileName String?
  mimeType String?
  // File location relative to EXPORT_DIR
  filePath String?

  // Progress
  rowsWritten Int @default(0)

  // Queue/worker leasing
  leaseUntil DateTime?
  attempts   Int      @default(0)

  // Legacy storage (kept for backward compatibility / migrations)
  csvBase64 String?

  error String?

  @@index([status, createdAt])
  @@index([requestedByUserId, createdAt])
}
